#!/bin/bash
# Reopen the Elgato Wave:3 input and make it the unmuted default source.
#
#   wave3-reset                 toggle the card profile to digital and back
#                               (wakes a stuck input), then set default + unmute
#   wave3-reset --default-only  set default + unmute only (no profile toggle)
#   wave3-reset --status        print key=value lines for the bar widget
#
# The card and source are found by name pattern, never by serial or id.
set -euo pipefail
# pactl output is parsed below; keep it untranslated.
export LC_ALL=C

CARD_PATTERN='^alsa_card[.]usb-Elgato_Systems_Elgato_Wave_3'
SOURCE_PATTERN='^alsa_input[.]usb-Elgato_Systems_Elgato_Wave_3'
# Headphone output. Reported even when the mic source is absent.
SINK_PATTERN='^alsa_output[.]usb-Elgato_Systems_Elgato_Wave_3'
ANALOG_PROFILE="output:analog-stereo+input:mono-fallback"
DIGITAL_PROFILE="output:iec958-stereo+input:mono-fallback"
# Polls of 0.2 s while waiting for the source to come back after a switch.
WAIT_TRIES="${WAVE3_WAIT_TRIES:-25}"

die() { echo "wave3-reset: $*" >&2; exit 1; }

# awk reads to the end: exiting early would SIGPIPE pactl and trip pipefail.
find_card() {
  pactl list short cards | awk -v p="$CARD_PATTERN" '!found && $2 ~ p { print $2; found = 1 }'
}

# Prints "<index> <name> <state>" for the Wave:3 input source.
# An input monitor shares this prefix, so ignore names ending in .monitor.
find_source() {
  pactl list short sources | awk -v p="$SOURCE_PATTERN" '!found && $2 ~ p && $2 !~ /\.monitor$/ { print $1, $2, $NF; found = 1 }'
}

# Prints "<index> <name> <state>" for the Wave:3 headphone sink.
find_sink() {
  pactl list short sinks | awk -v p="$SINK_PATTERN" '!found && $2 ~ p { print $1, $2, $NF; found = 1 }'
}

# Rounded mean of every N% token on the first line. Prints nothing if there
# are none. Reads the whole input so a short read cannot SIGPIPE pactl.
percent() {
  awk '
    NR == 1 {
      n = 0
      s = 0
      for (i = 1; i <= NF; i++)
        if ($i ~ /^[0-9]+%$/) { s += substr($i, 1, length($i) - 1); n++ }
      if (n) printf "%d\n", int(s / n + 0.5)
    }'
}

active_profile() { # active_profile <card>
  pactl list cards | awk -v c="$1" '
    $1 == "Name:" { in_card = ($2 == c) }
    in_card && /^[[:space:]]*Active Profile:/ { print $3 }'
}

# Both profiles keep the same mono-fallback source name, so a reopened source
# is told apart from the old one by its index.
switch_profile() { # switch_profile <card> <profile>
  local before src i
  before="$(find_source)"
  pactl set-card-profile "$1" "$2"
  for ((i = 0; i < WAIT_TRIES; i++)); do
    src="$(find_source)"
    if [ -n "$src" ] && [ "${src%% *}" != "${before%% *}" ]; then return 0; fi
    sleep 0.2
  done
  [ -n "$src" ] || die "Wave:3 source did not come back after switching to $2"
  echo "wave3-reset: warning: Wave:3 source was not recreated by switching to $2" >&2
}

set_default() { # set_default <source>
  local mute
  if [ "$(pactl get-default-source)" != "$1" ]; then
    pactl set-default-source "$1" 2>/dev/null || die "Wave:3 source $1 disappeared before it could be made default"
  fi
  mute="$(pactl get-source-mute "$1" 2>/dev/null)" || die "Wave:3 source $1 disappeared before it could be unmuted"
  [ "$mute" = "Mute: no" ] || pactl set-source-mute "$1" 0 2>/dev/null || die "Wave:3 source $1 disappeared before it could be unmuted"
}

source_name() { # source_name "<index> <name> <state>"
  local rest="${1#* }"
  echo "${rest% *}"
}

status() {
  local card src name state sinkline sink vol svol smute smute_line
  # A failing pactl (server down) reads as absent: --status always exits 0.
  card="$(find_card)" || card=""
  src="$(find_source)" || src=""
  sinkline="$(find_sink)" || sinkline=""
  sink=""
  vol=""
  svol=""
  smute="no"
  if [ -n "$sinkline" ]; then
    sink="$(source_name "$sinkline")"
    svol="$(pactl get-sink-volume "$sink" 2>/dev/null | percent)" || svol=""
    if smute_line="$(pactl get-sink-mute "$sink" 2>/dev/null)"; then
      [ "$smute_line" = "Mute: yes" ] && smute="yes" || smute="no"
    else
      smute=""
    fi
  fi
  if [ -z "$src" ]; then
    echo "present=no"
    echo "default=no"
    echo "muted=no"
    echo "state=absent"
    echo "profile=$( [ -n "$card" ] && active_profile "$card" )"
  else
    name="$(source_name "$src")"
    state="${src##* }"
    vol="$(pactl get-source-volume "$name" 2>/dev/null | percent)" || vol=""
    echo "present=yes"
    echo "default=$( [ "$(pactl get-default-source)" = "$name" ] && echo yes || echo no )"
    echo "muted=$( [ "$(pactl get-source-mute "$name")" = "Mute: yes" ] && echo yes || echo no )"
    echo "state=$state"
    echo "profile=$( [ -n "$card" ] && active_profile "$card" )"
    echo "source=$name"
  fi
  echo "volume=$vol"
  echo "sink=$sink"
  echo "sink_volume=$svol"
  echo "sink_muted=$smute"
}

mode="${1:-}"
case "$mode" in
  --status) status; exit 0 ;;
  ""|--default-only) ;;
  *) die "unknown option: $mode (use --status or --default-only)" ;;
esac

card="$(find_card)" || die "cannot reach the audio server (pactl failed)"
[ -n "$card" ] || die "Elgato Wave:3 not found (is it plugged in?)"

if [ "$mode" != "--default-only" ]; then
  switch_profile "$card" "$DIGITAL_PROFILE"
  switch_profile "$card" "$ANALOG_PROFILE"
fi

src="$(find_source)" || src=""
[ -n "$src" ] || die "Elgato Wave:3 input source not found (card $card, profile $(active_profile "$card"))"
name="$(source_name "$src")"
set_default "$name"
echo "wave3-reset: $name is the default source"
