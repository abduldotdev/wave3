#!/bin/bash
# Print the Elgato Wave:3 input peak, one integer per 100 ms line.
#
#   wave3-meter    stream peaks (0–32767) until the mic disappears or a signal
#
# The source is the first non-monitor name matching the Wave:3 input pattern.
# SIGTERM/SIGINT kills the capture pipeline: the shell is signaled alone, and
# a leftover parec would hold the mic open. There is no other stdout.
set -euo pipefail
# pactl and od output is parsed below; keep it untranslated.
export LC_ALL=C

SOURCE_PATTERN='^alsa_input[.]usb-Elgato_Systems_Elgato_Wave_3'

if [ "$#" -ne 0 ]; then
  echo "wave3-meter: unknown option: $1" >&2
  exit 2
fi

if ! sources="$(pactl list short sources 2>/dev/null)"; then
  echo "wave3-meter: cannot reach the audio server (pactl failed)" >&2
  exit 1
fi

name="$(printf '%s\n' "$sources" | awk -v p="$SOURCE_PATTERN" '
  !found && $2 ~ p && $2 !~ /\.monitor$/ { print $2; found = 1 }
')"
if [ -z "$name" ]; then
  echo "wave3-meter: Elgato Wave:3 input source not found" >&2
  exit 1
fi

# Background subshell so a trap can run while the pipeline is still going.
# Job control puts it in its own process group with parec, od and awk, so one
# group kill reaches all of them, even ones forked while the trap runs. $! is
# read in the trap too, for a signal landing before child= is assigned.
child=""
cleanup() {
  child="${child:-${!:-}}"
  if [ -n "$child" ]; then
    kill -TERM -- "-$child" 2>/dev/null || true
  fi
  wait 2>/dev/null || true
  exit 0
}
trap cleanup TERM INT
set -m

(
  parec --raw --format=s16le --channels=1 --rate=8000 --latency-msec=100 \
    --client-name="Wave:3 level meter" --stream-name="Wave:3 level meter" \
    -d "$name" \
  | od -An -v -td2 -w1600 \
  | awk '
      {
        peak = 0
        for (i = 1; i <= NF; i++) {
          v = $i + 0
          if (v < 0) v = -v
          if (v > 32767) v = 32767
          if (v > peak) peak = v
        }
        if (NF > 0) {
          printf "%d\n", peak
          fflush()
        }
      }'
) &
child=$!
# parec closing on its own (source removed) is a failure. A signal takes the trap.
set +e
wait "$child"
set -e
exit 1
